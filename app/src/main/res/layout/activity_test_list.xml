<?xml version="1.0" encoding="utf-8"?>
<!--
  测试功能列表页。
  列出项目中所有测试 Activity，点击对应按钮跳转进去测试。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="测试功能列表"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="1. 亮度 / 音量滑块" />

        <Button
            android:id="@+id/btn_glass_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="2. 液态玻璃底栏按钮" />

        <Button
            android:id="@+id/btn_system_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="3. 系统 Dialog 类型" />

        <Button
            android:id="@+id/btn_framework_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="4. Framework 原生 AlertDialog" />

        <Button
            android:id="@+id/btn_glass_dialog_launch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="5. KusaiGlassDialog 启动弹窗" />

        <Button
            android:id="@+id/btn_dagger_annotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="6. Dagger2 注解测试（30 项）" />

        <Button
            android:id="@+id/btn_permission_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="7. 系统权限申请（拒绝→跳转设置）" />

        <!-- prize add by yanliang for 液态玻璃库 API 演示入口, 20261023-start -->
        <Button
            android:id="@+id/btn_liquid_glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="8. 液态玻璃库 API 演示" />

        <Button
            android:id="@+id/btn_glass_share_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="9. 共享背景抓取机制测试" />
        <!-- prize add by yanliang for 液态玻璃库 API 演示入口, 20261023-end -->

    </LinearLayout>
</ScrollView>
